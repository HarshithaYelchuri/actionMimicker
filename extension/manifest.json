{
  "manifest_version": 3,
  "name": "Sync Input Standby MVP",
  "version": "1.1.0",
  "description": "Mirror cursor, clicks, typing and tab opens across connected browsers (MVP).",
  "permissions": ["storage", "tabs", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sync Input"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}